# ── Supabase ────────────────────────────────────────────────────────────
# Project URL (Settings → API). Public, safe to expose.
NEXT_PUBLIC_SUPABASE_URL="https://YOUR-PROJECT-REF.supabase.co"
# Publishable / anon key. Public, safe to expose. Found under Settings → API.
# In recent Supabase this is the `sb_publishable_...` key.
NEXT_PUBLIC_SUPABASE_ANON_KEY="sb_publishable_xxxxx"
# Service role key. NEVER expose to the client — server-side only.
# In recent Supabase this is the `sb_secret_...` key.
SUPABASE_SERVICE_ROLE_KEY="sb_secret_xxxxx"

# Direct Postgres connection string (used only by the migration runner + indexer
# script for DDL). Supabase Dashboard → Connect → ORM → Postgres. Keeps the
# pooler host.  sslmode=require.
DATABASE_URL="postgresql://postgres.xxxxx:[password]@aws-0-xx-x.pooler.supabase.com:6543/postgres"

# BNB testnet RPC used by the indexer.
BSC_TESTNET_RPC_URL="https://bsc-testnet-rpc.publicnode.com"

# ── App ─────────────────────────────────────────────────────────────────
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# ── ERC-8004 (Trustless Agents) on BSC testnet ──
# Official erc-8004/erc-8004-contracts registries, verified live on BSC testnet.
ERC8004_CHAIN_ID="97"
ERC8004_IDENTITY_REGISTRY="0x8004A818BFB912233c491871b3d84c89A494BD9e"
ERC8004_REPUTATION_REGISTRY="0x8004B663056A597Dffe9eCcC1965A193B7388713"
# Private key of the owner/signer used by registerAgentIdentity + giveFeedback.
ERC8004_SIGNER_KEY="0x0000..."
